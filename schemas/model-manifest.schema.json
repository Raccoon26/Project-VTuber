{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "revision",
    "provider",
    "kind",
    "developer",
    "official_source",
    "download_url",
    "format",
    "bytes",
    "sha256",
    "code_license",
    "weights_license",
    "dependency_licenses",
    "license_review",
    "commercial_use",
    "redistribution",
    "allowed_regions",
    "output_restrictions",
    "runtime",
    "backends",
    "ram_mib",
    "vram_mib",
    "disk_mib",
    "input",
    "output",
    "preprocessing",
    "verified_hardware",
    "evidence",
    "network_during_inference"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "developer": {
      "type": "string",
      "minLength": 1
    },
    "official_source": {
      "type": "string",
      "minLength": 1
    },
    "download_url": {
      "type": ["string", "null"]
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "code_license": {
      "type": "string",
      "minLength": 1
    },
    "weights_license": {
      "type": "string",
      "minLength": 1
    },
    "dependency_licenses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license_review": {
      "type": "string",
      "minLength": 1
    },
    "commercial_use": {
      "type": "boolean"
    },
    "redistribution": {
      "type": "boolean"
    },
    "allowed_regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_restrictions": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "backends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ram_mib": {
      "type": "integer",
      "minimum": 0
    },
    "vram_mib": {
      "type": "integer",
      "minimum": 0
    },
    "disk_mib": {
      "type": "integer",
      "minimum": 0
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "preprocessing": {
      "type": "string",
      "minLength": 1
    },
    "verified_hardware": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "network_during_inference": {
      "type": "boolean"
    }
  }
}
